# Required: the stack will not start until every value in this block is set,
# and the API refuses these placeholder values in production.

# ─── Database ─────────────────────────────────────────────────
CENTRAL_DB_PASSWORD=change-me-central
TENANT_DB_PASSWORD=change-me-tenant

# ─── Auth ─────────────────────────────────────────────────────
# Two different values, each from: openssl rand -hex 32
JWT_SECRET=generate-a-random-64-char-string
JWT_REFRESH_SECRET=generate-a-different-64-char-string

# ─── Encryption (64 hex chars = 256 bits) ─────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ─── Email (optional — emails will be skipped if not set) ─────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# ─── Service URLs ────────────────────────────────────────────
# Used for cross-service linking, CORS, and OpenAPI docs.
# Defaults work for Docker Compose (localhost:4000-4003).
# For production with a domain, set these to your actual URLs:
#   API_URL=https://api.yourdomain.com
#   LANDING_URL=https://yourdomain.com
#   DASHBOARD_URL=https://app.yourdomain.com
#   DOCS_URL=https://docs.yourdomain.com
#
# API_URL=http://localhost:4000
# LANDING_URL=http://localhost:4001
# DASHBOARD_URL=http://localhost:4002   (used in invitation, password-reset and portal links)
# DOCS_URL=http://localhost:4003

# ─── Port Overrides (optional) ──────────────────────────────
# API_PORT=4000
# LANDING_PORT=4001
# DASHBOARD_PORT=4002
# DOCS_PORT=4003

# ─── GHCR (for production deploys) ───────────────────────────
# GHCR_OWNER=pimabill

# ─── Branding ───────────────────────────────────────────────
# Product name and details shown in the dashboard, emails, PDFs and API docs.
# The dashboard reads these at build time (rebuild after changing them).
BRAND_NAME=
BRAND_LOGO=
BRAND_TAGLINE=
BRAND_PRIMARY=
BRAND_SUPPORT_EMAIL=
BRAND_WEBSITE=
# Identifier sent to providers (e.g. Stripe metadata). Leave as is unless you
# know nothing filters on it.
BRAND_SLUG=

# ─── Platform console & ledger ──────────────────────────────
# Comma-separated tenant ids whose dashboard logins can open the platform console
# (or run `npm run platform:operator -- <email>` once instead).
PLATFORM_ADMIN_TENANT_IDS=
# Lets your own control plane list organisations and set their access (32+ characters). Leave empty to turn it off.
PLATFORM_SERVICE_TOKEN=

# Managed payments (optional): subscription to the managed payments service, for
# tenants without their own provider accounts. Leave empty to turn it off.
MANAGED_PAYMENTS_URL=
MANAGED_PAYMENTS_API_KEY=
MANAGED_PAYMENTS_WEBHOOK_SECRET=
# shadow: build the double-entry ledger alongside billing; off: disable it.
LEDGER_MODE=shadow

# ─── Network safety ─────────────────────────────────────────
# Tenant webhook URLs and SMTP hosts must be public addresses. Set to true only
# if tenants deliver to receivers on your private network (self-hosted, trusted tenants).
# ALLOW_PRIVATE_WEBHOOK_URLS=false

# ─── Tenant database pools (per API/worker process) ─────────
# TENANT_POOL_SIZE=5
# Close a tenant pool's idle connections after this many ms (sweeps visit every tenant).
# TENANT_POOL_IDLE_MS=10000
# max_connections of the shared tenant Postgres (docker-compose.prod.yml).
# TENANT_DB_MAX_CONNECTIONS=300
# TENANT_CLIENT_CACHE_SIZE=200
