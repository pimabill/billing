generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-central"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DatabaseProvider {
  INTERNAL
}

// What an organisation may do. Set by the platform operator, or by a control
// plane through the service API; the operator organisation is never limited.
enum TenantAccess {
  FULL
  READ_ONLY
  SUSPENDED
}

// An organisation (merchant). People reach it through memberships; `email`
// is its contact address and `password` is only the pre-membership login,
// kept so older databases migrate cleanly.
model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  email        String
  password     String?
  // Legacy plaintext key, cleared once hashed; only apiKeyHash is used to authenticate.
  apiKey       String?  @unique
  apiKeyHash   String?  @unique
  apiKeyLast4  String?
  webhookUrl   String?
  webhookSecret String?
  isActive     Boolean  @default(true)
  settings     Json?
  lastLoginAt  DateTime?
  // Owners and admins of an operator organisation run the platform console.
  isPlatformOperator Boolean      @default(false)
  accessMode         TenantAccess @default(FULL)
  // Shown to the organisation while access is limited, with where to fix it.
  accessReason       String?
  accessUrl          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  databaseConnection DatabaseConnection?
  tenantBilling      TenantBilling?
  ledgerStatus       TenantLedgerStatus?
  apiUsage           ApiUsageHourly[]
  dailyMetrics       TenantMetricsDaily[]
  apiKeys            ApiKey[]
  webhookLogs        WebhookLog[]
  memberships        Membership[]
  invitations        Invitation[]

  @@index([slug])
  @@index([email])
}

// A person who signs in to the dashboard. One user can belong to several
// organisations, with a role in each.
model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  password    String
  isActive    Boolean      @default(true)
  lastLoginAt DateTime?
  // Sessions issued before this are rejected (password reset or change).
  passwordChangedAt DateTime?
  // Two-step sign-in with an authenticator app (TOTP). Secrets are encrypted;
  // recovery codes are stored as hashes and each works once.
  mfaSecret         String?
  mfaPendingSecret  String?
  mfaEnabledAt      DateTime?
  mfaRecoveryCodes  String[]  @default([])
  // The last time step accepted, so a code cannot be used twice.
  mfaLastStep       Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

// OWNER: everything, including other owners and deleting the organisation.
// ADMIN: everything else, including team and payment providers.
// FINANCE: customers, billing and money movement, including payout approval.
// DEVELOPER: read everything; API keys and webhooks.
// VIEWER: read only.
enum MemberRole {
  OWNER
  ADMIN
  FINANCE
  DEVELOPER
  VIEWER
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      MemberRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// An invitation to join an organisation; the token is sent once and stored hashed.
model Invitation {
  id         String     @id @default(cuid())
  tenantId   String
  email      String
  role       MemberRole
  tokenHash  String     @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model DatabaseConnection {
  id              String           @id @default(cuid())
  tenantId        String           @unique
  provider        DatabaseProvider @default(INTERNAL)
  connectionUrl   String
  isHealthy       Boolean          @default(true)
  lastHealthCheck DateTime?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantBilling {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  stripeCustomerId String?   @unique
  planId           String?
  status           String    @default("active")
  trialEndsAt      DateTime?
  // Set by the operator or its control plane: the plan's name, its limits
  // (see common/guards/plan-limits.ts; null means none) and where to manage it.
  planName         String?
  limits           Json?
  manageUrl        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  // Legacy plaintext key, cleared once hashed; only keyHash is used to authenticate.
  key       String?   @unique
  keyHash   String?   @unique
  last4     String?
  name      String
  // "read" allows GET/HEAD/OPTIONS only; "write" allows everything.
  scopes    String[]
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WebhookLog {
  id           String   @id @default(cuid())
  tenantId     String
  event        String
  url          String
  payload      Json
  response     Json?
  statusCode   Int?
  success      Boolean  @default(false)
  attemptCount Int      @default(1)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([event])
  @@index([createdAt])
}

// Latest ledger sync and integrity result per tenant, written by the ledger
// runner so the platform console can show ledger health without opening every
// tenant database.
model TenantLedgerStatus {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  lastSyncAt     DateTime?
  lastCheckAt    DateTime?
  balanced       Boolean   @default(true)
  // Informational differences (e.g. wallet balance vs ledger) found by the last check.
  warnings       Int       @default(0)
  entriesPosted  Int       @default(0)
  failedPostings Int       @default(0)
  lastError      String?
  checks         Json?
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([balanced])
}

// ============================================================
// Platform visibility
// ============================================================

// API request counters per tenant, hour, route and client, flushed from each
// API process every minute (increments, so several replicas add up).
model ApiUsageHourly {
  id          String   @id @default(cuid())
  tenantId    String
  hour        DateTime
  // Route pattern, e.g. "GET /api/invoices/:id"
  route       String
  // "session" (dashboard) or "api_key"
  authMethod  String
  // Client SDK and version from request headers, or "http" when unknown
  client      String
  requests    Int      @default(0)
  clientErrors Int     @default(0)
  serverErrors Int     @default(0)
  totalMs     BigInt   @default(0)
  maxMs       Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, hour, route, authMethod, client])
  @@index([hour])
  @@index([tenantId, hour])
}

// Daily snapshot of each tenant's usage, built by a job that reads every
// tenant database. Aggregates only: no customer names, emails or phone numbers.
model TenantMetricsDaily {
  id                  String   @id @default(cuid())
  tenantId            String
  date                DateTime @db.Date
  customers           Int      @default(0)
  activeSubscriptions Int      @default(0)
  invoicesIssued30d   Int      @default(0)
  paymentsSucceeded30d Int     @default(0)
  paymentsFailed30d   Int      @default(0)
  // { "UGX": "1250000.0000", "USD": "310.5000" }
  paymentVolume30d    Json?
  // { "USD": "1200.0000" } — monthly-normalised plan prices of active subscriptions
  mrr                 Json?
  // { "flutterwave": { "succeeded": 12, "failed": 1 } }
  providerStats30d    Json?
  providersConfigured String[]
  // Product areas the tenant has data in, e.g. ["subscriptions", "wallets", "usage_metering"]
  featuresUsed        String[]
  firstPaymentAt      DateTime?
  lastPaymentAt       DateTime?
  // { collections: { count, volume: {UGX: "..."} }, payouts: {...}, transfers: { count },
  //   stuck: n, awaitingApproval: n } over the last 30 days (open counts are current)
  moneyMovement30d    Json?
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([date])
}

/// Daily exchange rates, shared by every organisation: units of `currency` per one US dollar.
/// Amounts are converted at the rate of their own day, so past months keep the rate they had.
model ExchangeRate {
  date      DateTime @db.Date
  currency  String
  perUsd    Decimal  @db.Decimal(24, 10)
  source    String
  createdAt DateTime @default(now())

  @@id([date, currency])
  @@index([currency, date])
}
