{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "prerelease": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "pimabill",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "backend/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "backend/openapi/openapi.json", "jsonpath": "$.info.version" },
        { "type": "json", "path": "dashboard/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "landing/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "docs/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
